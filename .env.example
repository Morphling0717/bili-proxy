# Optional: full Bilibili cookie string. Keep this only in Vercel environment variables.
# Expired login fields are automatically removed before anonymous public fallbacks run.
BI_COOKIE=

# Optional: used when the request omits ?mid=.
TARGET_UID=3546779356235807

# Optional: restrict browser clients to one origin. Default is *.
CORS_ORIGIN=

# Optional request tuning.
BILI_TIMEOUT_MS=10000
BILI_USER_AGENT=

# Signed BiliDroid video fallback is enabled by default.
APP_FALLBACK=1

# Chromium is a slow last resort and is disabled by default.
BROWSER_FALLBACK=0
BILI_BROWSER_USER_AGENT=

# Local development only. Vercel uses @sparticuz/chromium automatically.
CHROME_EXECUTABLE_PATH=
